{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-mcp-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  "vars": {
    "TOPVISOR_USER_ID": "278724"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codex-mcp-data",
      "database_id": "d43429e5-aeea-4506-b839-4fe60a20a74c",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
